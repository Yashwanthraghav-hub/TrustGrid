    "db:types": "node --env-file-if-exists=.env.local scripts/database-types.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "admin:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs",
    "holds:expire": "node --env-file-if-exists=.env.local scripts/expire-holds.mjs",
