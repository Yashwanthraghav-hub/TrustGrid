# Public values are compiled into the browser bundle. Rebuild after changing them.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional map. No map tiles are requested until configured; always include attribution.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Server-only. List account models with npm run ai:models; do not guess GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=
HANDOFF_HASH_SECRET=
CRON_SECRET=
# Setup-only: never expose these through NEXT_PUBLIC_ variables.
DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_USER_ID=
BOOTSTRAP_ORG_NAME=TrustGrid Community
# Default invite-only. Set true only to authorize public account joining.
ALLOW_PUBLIC_JOIN=false
# Existing org UUID for re-running bootstrap, expiry, or demo seed.
ORGANIZATION_ID=
# Seed only existing legitimate auth UUIDs. Five independent identities recommended.
DEMO_AUTH_USERS=
# Dedicated disposable PostgreSQL integration environment only.
TEST_DATABASE_URL=
TRUSTGRID_TEST_DATABASE=
